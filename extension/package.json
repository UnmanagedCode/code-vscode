{
  "name": "code-vscode",
  "displayName": "Code Conductor",
  "description": "Shows cc conductor sessions in VS Code editor tabs and turns the editor selection, or the active file, into its context chip.",
  "version": "0.1.0",
  "publisher": "code-conductor",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:codeConductor.session"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codeConductor.open",
        "title": "cc: Open",
        "icon": {
          "light": "media/icon-light.svg",
          "dark": "media/icon-dark.svg"
        }
      }
    ],
    "configuration": {
      "title": "Code Conductor",
      "properties": {
        "codeConductor.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8787",
          "markdownDescription": "The cc URL as seen from the machine the extension runs on (the remote host in a VS Code Remote window). The code-vscode plugin must be enabled in that cc."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "codeConductor.open",
          "group": "navigation",
          "when": "activeEditor == workbench.editors.files.textFileEditor || activeEditor == workbench.editors.textResourceEditor"
        }
      ]
    }
  },
  "scripts": {
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.0.0"
  }
}
